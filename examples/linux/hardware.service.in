[Unit]
Description=Example product hardware
Before=openavc-product-management.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@/data
Environment=OPENAVC_PRODUCT_SOCKET=@ROOT@/run/hardware.sock
Environment=OPENAVC_DEVICE_ID=@IDENTITY@
Environment=LD_LIBRARY_PATH=@ROOT@/program/lib
ExecStart=@ROOT@/program/hardware @ROOT@/program/model.json - --daemon
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@ROOT@/data @ROOT@/run

[Install]
WantedBy=multi-user.target
