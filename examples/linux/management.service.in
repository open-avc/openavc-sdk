[Unit]
Description=OpenAVC product integration
Wants=openavc-product-hardware.service
After=openavc-product-hardware.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@/data
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=@RUNTIME@/tmp
Environment=LD_LIBRARY_PATH=@ROOT@/program/lib
ExecStart=@PYTHON@ -m openavc_oem --config @ROOT@/private/openavc.json
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@ROOT@/data @RUNTIME@

[Install]
WantedBy=multi-user.target
